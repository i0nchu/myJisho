FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KOTOBA_API_HOST=0.0.0.0

WORKDIR /app

RUN useradd --create-home --uid 10001 kotoba \
    && mkdir -p /data \
    && chown kotoba:kotoba /data

COPY --chown=kotoba:kotoba packages /app/packages
COPY --chown=kotoba:kotoba services/local_dictionary /app/services/local_dictionary

USER kotoba

EXPOSE 8766
VOLUME ["/data"]

CMD ["python", "-m", "services.local_dictionary", "--database", "/data/local_dictionary.sqlite"]
